[Unit]
Description=Backup Library PocketBase data (encrypted)
After=corelib-pocketbase.service

[Service]
Type=oneshot
ExecStart=/opt/corelib-pocketbase/backup-pocketbase.sh
EnvironmentFile=/etc/corelib-pocketbase.env
Environment=GNUPGHOME=/var/lib/corelib-pocketbase/gnupg

ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/corelib-pocketbase
PrivateTmp=true
NoNewPrivileges=true
